<?xml version="1.0"?>
<!-- Kinova Gen3 7-DOF (kortex_description, no gripper) with the camera placeholder and tool0 of panda_arm_moveit's
     panda.urdf, so the same viewpoints (tool0 poses) apply. External-cable joint limits: joints 1, 3, 5, 7 within
     +-2 pi instead of continuous, so a joint's angle has no wrap-around and joint distance is real motion. -->
<robot name="gen3" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:include filename="$(find kortex_description)/robots/kortex_robot.xacro" />
    <link name="world" />
    <xacro:load_robot
        parent="world"
        arm="gen3"
        gripper=""
        gripper_joint_name="finger_joint"
        gripper_max_velocity="100.0"
        gripper_max_force="100.0"
        dof="7"
        vision="false"
        robot_ip="192.168.11.11"
        username="admin"
        password="admin"
        port="10000"
        port_realtime="10001"
        session_inactivity_timeout_ms="60000"
        connection_inactivity_timeout_ms="2000"
        use_internal_bus_gripper_comm="false"
        prefix=""
        use_fake_hardware="true"
        fake_sensor_commands="false"
        sim_gazebo="false"
        sim_ignition="false"
        sim_isaac="false"
        use_external_cable="true"
        initial_positions="${dict(joint_1=0.0,joint_2=0.0,joint_3=0.0,joint_4=0.0,joint_5=0.0,joint_6=0.0,joint_7=0.0)}">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:load_robot>

    <!-- Camera placeholder, as panda_hand: a thin cylinder from the flange to tool0. -->
    <joint name="camera_joint" type="fixed">
        <parent link="end_effector_link" />
        <child link="camera" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <link name="camera">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.01" length="0.1" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.01" length="0.1" />
            </geometry>
        </collision>
    </link>
    <joint name="tool0_joint" type="fixed">
        <parent link="camera" />
        <child link="tool0" />
        <origin xyz="0 0 0.1034" rpy="0 0 0" />
    </joint>
    <link name="tool0" />
</robot>
