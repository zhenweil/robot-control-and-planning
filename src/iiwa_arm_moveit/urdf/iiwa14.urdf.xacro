<?xml version="1.0"?>
<!-- KUKA LBR iiwa 14 (lbr_description) with the camera placeholder and tool0 of panda_arm_moveit's panda.urdf, so the
     same viewpoints (tool0 poses) apply. No world link: the SRDF's virtual joint fixes lbr_link_0 to world, as for the Panda. -->
<robot name="iiwa14" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find lbr_description)/urdf/iiwa14/iiwa14_description.xacro" />
    <xacro:iiwa14 robot_name="lbr" mode="mock" />

    <!-- Camera placeholder, as panda_hand: a thin cylinder from the flange to tool0. Turned half a turn so the Panda
         home's tool0 pose has A7 near 0, mid-range. -->
    <joint name="camera_joint" type="fixed">
        <parent link="lbr_link_ee" />
        <child link="camera" />
        <origin xyz="0 0 0" rpy="0 0 3.14159265359" />
    </joint>
    <link name="camera">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.01" length="0.1" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.01" length="0.1" />
            </geometry>
        </collision>
    </link>
    <joint name="tool0_joint" type="fixed">
        <parent link="camera" />
        <child link="tool0" />
        <origin xyz="0 0 0.1034" rpy="0 0 0" />
    </joint>
    <link name="tool0" />
</robot>
